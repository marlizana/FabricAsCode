# Workshop de Git (viernes 6/11, 10:00-14:00, unas 20 personas).
# Copiar a environments/workshop.tfvars (NO commitear: lleva nombres y usuarios de GitHub).
# Uso:
#   terraform workspace new workshop   # estado separado de la demo
#   terraform apply -var-file=environments/workshop.tfvars
#   terraform output -json workshop_credentials > credenciales.json   # NO commitear
#   ...workshop...
#   terraform destroy -var-file=environments/workshop.tfvars

capacity_name           = "fbcgitws"
randomize_capacity_name = true
# 25 personas guardando y sincronizando a la vez: F8 durante el taller y pausar al acabar.
capacity_sku = "F8"
region       = "spaincentral"

template     = "workshop"
project_name = "gitws" # -> userN-gitws@dominio, ws-gitws-userN, ws-gitws-team

workshop_tenant_domain          = "akanemar.onmicrosoft.com"
workshop_facilitator_object_ids = ["<object-id-de-mar.lizana>"]

# Sin lista de asistentes: 20 alumnos genericos user1..user20.
workshop_attendee_count = 20

# Con lista (sustituye a workshop_attendee_count). github_username se rellena el dia del taller
# y se re-aplica para invitarles a su repo y al repo team.
# workshop_attendees = [
#   { name = "Asistente Uno", github_username = "github-user-1" },
#   { name = "Asistente Dos" },
# ]

# El repo de contenido de la demo no aplica al workshop.
enable_github_cicd = false
github_owner       = "marlizana"

budget_amount         = 150
budget_contact_emails = ["tu-correo@ejemplo.com"]

tags = {
  managed_by = "terraform"
  project    = "workshop-git"
}
